generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id          String       @id @default(cuid())
  name        String
  teamMembers TeamMember[]
}

model Team {
  id             String             @id @default(cuid())
  name           String
  isFlexible     Boolean            @default(false)
  members        TeamMember[]
  results        TournamentResult[]
  matchesAsTeamA Match[]            @relation("MatchTeamA")
  matchesAsTeamB Match[]            @relation("MatchTeamB")
}

model TeamMember {
  id            String      @id @default(cuid())
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])

  @@unique([teamId, participantId])
}

model Tournament {
  id             String             @id @default(cuid())
  name           String
  status         String             @default("pending")
  order          Int                @default(0)
  activePlayerId String?
  results        TournamentResult[]
  matches        Match[]
  createdAt      DateTime           @default(now())
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  teamAId      String
  teamA        Team       @relation("MatchTeamA", fields: [teamAId], references: [id])
  teamBId      String
  teamB        Team       @relation("MatchTeamB", fields: [teamBId], references: [id])
  scoreA       Int?
  scoreB       Int?

  @@unique([tournamentId, teamAId, teamBId])
}

model TournamentResult {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id])
  position     Int
  points       Int

  @@unique([tournamentId, teamId])
  @@unique([tournamentId, position])
}

model Settings {
  id            String  @id @default("main")
  drawCompleted Boolean @default(false)
}
